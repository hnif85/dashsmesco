{
  "designSystem": {
    "name": "Dashboard Overview Design System",
    "description": "Ekstraksi styling dari dashboard template",
    
    "colors": {
      "primary": {
        "background": "#000000",
        "backgroundLight": "#0a0a0a",
        "backgroundCard": "#111111",
        "backgroundCardHover": "#1a1a1a"
      },
      "text": {
        "primary": "#ffffff",
        "secondary": "#999999",
        "tertiary": "#666666",
        "muted": "#4a4a4a"
      },
      "border": {
        "default": "#1a1a1a",
        "hover": "#333333",
        "active": "#444444"
      },
      "accent": {
        "cyan": "#06b6d4",
        "teal": "#14b8a6",
        "green": "#22c55e",
        "orange": "#f97316",
        "red": "#ef4444",
        "purple": "#a855f7",
        "blue": "#3b82f6",
        "yellow": "#eab308"
      },
      "status": {
        "success": {
          "background": "#1a3a1a",
          "border": "#2a4a2a",
          "text": "#4ade80"
        },
        "warning": {
          "background": "#3a3a1a",
          "border": "#4a4a2a",
          "text": "#fbbf24"
        },
        "danger": {
          "background": "#3a1a1a",
          "border": "#4a2a2a",
          "text": "#f87171"
        },
        "info": {
          "background": "#1a2a3a",
          "border": "#2a3a4a",
          "text": "#60a5fa"
        }
      }
    },
    
    "typography": {
      "fontFamily": {
        "primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
        "mono": "'Courier New', monospace"
      },
      "fontSize": {
        "xs": "11px",
        "sm": "12px",
        "base": "14px",
        "md": "15px",
        "lg": "16px",
        "xl": "18px",
        "2xl": "20px",
        "3xl": "24px",
        "4xl": "32px",
        "5xl": "36px",
        "6xl": "48px"
      },
      "fontWeight": {
        "light": "300",
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "lineHeight": {
        "tight": "1.2",
        "normal": "1.5",
        "relaxed": "1.75"
      },
      "letterSpacing": {
        "tight": "-0.5px",
        "normal": "0",
        "wide": "0.5px",
        "wider": "1px",
        "widest": "2px"
      }
    },
    
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "base": "16px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "40px",
      "4xl": "48px",
      "5xl": "64px"
    },
    
    "borderRadius": {
      "sm": "4px",
      "base": "6px",
      "md": "8px",
      "lg": "12px",
      "xl": "16px",
      "full": "9999px"
    },
    
    "components": {
      "header": {
        "background": "#0a0a0a",
        "borderBottom": "1px solid #1a1a1a",
        "padding": "24px 40px",
        "title": {
          "fontSize": "20px",
          "fontWeight": "500",
          "color": "#ffffff",
          "letterSpacing": "-0.5px"
        },
        "subtitle": {
          "fontSize": "13px",
          "color": "#666666",
          "marginTop": "4px"
        }
      },
      
      "sidebar": {
        "width": "240px",
        "background": "#000000",
        "borderRight": "1px solid #1a1a1a",
        "padding": "20px 0",
        "item": {
          "padding": "12px 24px",
          "fontSize": "14px",
          "color": "#999999",
          "hoverBackground": "#1a1a1a",
          "hoverColor": "#ffffff",
          "activeBackground": "#1a1a1a",
          "activeColor": "#ffffff",
          "activeBorderLeft": "3px solid #06b6d4"
        },
        "icon": {
          "size": "20px",
          "marginRight": "12px"
        }
      },
      
      "card": {
        "background": "linear-gradient(135deg, #0a0a0a 0%, #111 100%)",
        "border": "1px solid #1a1a1a",
        "borderRadius": "12px",
        "padding": "28px",
        "hoverBorder": "#333333",
        "hoverTransform": "translateY(-2px)",
        "transition": "all 0.3s ease",
        "topBorder": {
          "height": "2px",
          "background": "linear-gradient(90deg, #333, #666, #333)",
          "opacity": "0",
          "hoverOpacity": "1"
        }
      },
      
      "statCard": {
        "background": "#0a0a0a",
        "border": "1px solid #1a1a1a",
        "borderRadius": "12px",
        "padding": "24px",
        "title": {
          "fontSize": "13px",
          "color": "#999999",
          "textTransform": "uppercase",
          "letterSpacing": "1px",
          "marginBottom": "12px"
        },
        "value": {
          "fontSize": "36px",
          "fontWeight": "300",
          "color": "#ffffff",
          "letterSpacing": "-1px"
        },
        "subtitle": {
          "fontSize": "12px",
          "color": "#666666",
          "marginTop": "8px"
        },
        "icon": {
          "size": "24px",
          "position": "top-right"
        }
      },
      
      "chart": {
        "background": "transparent",
        "line": {
          "color": "#06b6d4",
          "width": "2px",
          "tension": "0.4"
        },
        "point": {
          "radius": "4px",
          "backgroundColor": "#06b6d4",
          "borderColor": "#ffffff",
          "borderWidth": "2px",
          "hoverRadius": "6px"
        },
        "grid": {
          "color": "#1a1a1a",
          "lineWidth": "1px"
        },
        "axis": {
          "color": "#666666",
          "fontSize": "11px"
        },
        "tooltip": {
          "background": "#1a1a1a",
          "border": "1px solid #333333",
          "borderRadius": "6px",
          "padding": "8px 12px",
          "color": "#ffffff",
          "fontSize": "12px"
        }
      },
      
      "quickActions": {
        "background": "#0a0a0a",
        "border": "1px solid #1a1a1a",
        "borderRadius": "12px",
        "padding": "24px",
        "title": {
          "fontSize": "16px",
          "fontWeight": "500",
          "color": "#ffffff",
          "marginBottom": "20px"
        },
        "item": {
          "padding": "12px 0",
          "borderBottom": "1px solid #1a1a1a",
          "hoverBackground": "#0f0f0f",
          "text": {
            "fontSize": "14px",
            "color": "#ffffff"
          },
          "badge": {
            "fontSize": "12px",
            "fontWeight": "500",
            "padding": "4px 10px",
            "borderRadius": "6px",
            "colors": {
              "red": {
                "background": "#3a1a1a",
                "text": "#ef4444"
              },
              "green": {
                "background": "#1a3a1a",
                "text": "#22c55e"
              },
              "purple": {
                "background": "#2a1a3a",
                "text": "#a855f7"
              },
              "orange": {
                "background": "#3a2a1a",
                "text": "#f97316"
              }
            }
          }
        }
      },
      
      "table": {
        "background": "#0a0a0a",
        "border": "1px solid #1a1a1a",
        "borderRadius": "12px",
        "header": {
          "background": "#050505",
          "borderBottom": "1px solid #1a1a1a",
          "padding": "16px 32px",
          "fontSize": "11px",
          "fontWeight": "500",
          "color": "#666666",
          "textTransform": "uppercase",
          "letterSpacing": "0.5px"
        },
        "row": {
          "padding": "20px 32px",
          "borderBottom": "1px solid #0f0f0f",
          "hoverBackground": "#0f0f0f",
          "transition": "background-color 0.2s ease"
        },
        "cell": {
          "fontSize": "14px",
          "color": "#ffffff"
        }
      },
      
      "button": {
        "primary": {
          "background": "#06b6d4",
          "color": "#ffffff",
          "border": "none",
          "borderRadius": "6px",
          "padding": "10px 20px",
          "fontSize": "14px",
          "fontWeight": "500",
          "hoverBackground": "#0891b2",
          "transition": "all 0.2s ease"
        },
        "secondary": {
          "background": "transparent",
          "color": "#ffffff",
          "border": "1px solid #333333",
          "borderRadius": "6px",
          "padding": "10px 20px",
          "fontSize": "14px",
          "fontWeight": "500",
          "hoverBackground": "#1a1a1a",
          "hoverBorder": "#444444",
          "transition": "all 0.2s ease"
        },
        "ghost": {
          "background": "transparent",
          "color": "#999999",
          "border": "none",
          "borderRadius": "6px",
          "padding": "10px 20px",
          "fontSize": "14px",
          "fontWeight": "500",
          "hoverColor": "#ffffff",
          "hoverBackground": "#1a1a1a",
          "transition": "all 0.2s ease"
        }
      },
      
      "badge": {
        "small": {
          "padding": "2px 8px",
          "fontSize": "11px",
          "borderRadius": "10px"
        },
        "medium": {
          "padding": "4px 10px",
          "fontSize": "12px",
          "borderRadius": "6px"
        },
        "large": {
          "padding": "6px 12px",
          "fontSize": "13px",
          "borderRadius": "8px"
        }
      },
      
      "dropdown": {
        "background": "#1a1a1a",
        "border": "1px solid #333333",
        "borderRadius": "6px",
        "padding": "8px 16px",
        "color": "#ffffff",
        "fontSize": "14px",
        "hoverBackground": "#222222",
        "menu": {
          "background": "#1a1a1a",
          "border": "1px solid #333333",
          "borderRadius": "8px",
          "boxShadow": "0 4px 12px rgba(0, 0, 0, 0.5)",
          "item": {
            "padding": "10px 16px",
            "fontSize": "14px",
            "color": "#ffffff",
            "hoverBackground": "#222222"
          }
        }
      },
      
      "progressBar": {
        "height": "4px",
        "background": "#1a1a1a",
        "borderRadius": "2px",
        "fill": {
          "background": "linear-gradient(90deg, #333, #666)",
          "transition": "width 0.3s ease"
        }
      }
    },
    
    "effects": {
      "boxShadow": {
        "sm": "0 1px 2px rgba(0, 0, 0, 0.3)",
        "base": "0 2px 4px rgba(0, 0, 0, 0.3)",
        "md": "0 4px 8px rgba(0, 0, 0, 0.4)",
        "lg": "0 8px 16px rgba(0, 0, 0, 0.5)",
        "xl": "0 12px 24px rgba(0, 0, 0, 0.6)"
      },
      "transition": {
        "fast": "150ms ease",
        "base": "200ms ease",
        "slow": "300ms ease",
        "slower": "500ms ease"
      }
    },
    
    "layout": {
      "container": {
        "maxWidth": "1600px",
        "padding": "0 40px",
        "margin": "0 auto"
      },
      "grid": {
        "columns": {
          "1": "repeat(1, 1fr)",
          "2": "repeat(2, 1fr)",
          "3": "repeat(3, 1fr)",
          "4": "repeat(4, 1fr)",
          "auto-fit": "repeat(auto-fit, minmax(280px, 1fr))"
        },
        "gap": {
          "sm": "16px",
          "base": "24px",
          "lg": "32px"
        }
      }
    },
    
    "responsive": {
      "breakpoints": {
        "mobile": "480px",
        "tablet": "768px",
        "desktop": "1024px",
        "wide": "1280px",
        "ultrawide": "1600px"
      },
      "mobileAdjustments": {
        "container": {
          "padding": "0 20px"
        },
        "header": {
          "padding": "20px"
        },
        "card": {
          "padding": "20px"
        },
        "grid": {
          "columns": "1fr"
        },
        "table": {
          "fontSize": "12px",
          "padding": "12px"
        }
      }
    }
  }
}